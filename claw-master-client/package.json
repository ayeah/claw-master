{
  "name": "claw-master-client",
  "version": "2.3.0",
  "description": "claw-master AI 军团控制台 - 本地客户端",
  "main": "./out/main/index.js",
  "author": "claw-master",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "node scripts/bump-version.js && electron-vite build && electron-builder --win portable",
    "build:mac": "node scripts/bump-version.js && electron-vite build && electron-builder --mac",
    "build:linux": "node scripts/bump-version.js && electron-vite build && electron-builder --linux",
    "build:portable": "build-exe.bat",
    "version": "node scripts/version-current.js",
    "version:current": "node scripts/version-current.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major"
  },
  "dependencies": {
    "@types/ssh2": "^1.15.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "openai": "^4.73.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^2.5.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.claw-master.client",
    "productName": "Claw Master",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
